{
  "name": "regenerative-atlas",
  "version": "0.1.0",
  "description": "An open-source, collective library of regenerative research, mapped as a constellation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "check-links": "node --disable-warning=ExperimentalWarning scripts/check-links.js",
    "check-seed": "node --disable-warning=ExperimentalWarning scripts/check-links.js --seed"
  },
  "keywords": [
    "regenerative-design",
    "bibliography",
    "knowledge-graph",
    "open-source",
    "built-environment"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mmalinadabrowska/regenerative-atlas.git"
  },
  "dependencies": {}
}

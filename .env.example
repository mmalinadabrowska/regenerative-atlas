# The Supabase project that keeps the library.
#
# With these unset the Atlas runs exactly as it always has, on the SQLite file
# in data/ — everything below is opt-in. With them set, the server pulls the
# library down on boot and writes every new source up as it arrives.
#
# The service role key writes. It must never reach a browser: set it on the
# machine that runs the server and nowhere else. The anon key can only read,
# and is the one to use anywhere public.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

lookup liga_4 {
# GSUB lookup 6, type 11 (Single)
  sub [uni0065 uni0045 uni00E8 Egrave] by [emacron Emacron emacron Emacron];
  sub [eacute Eacute] by [emacron Emacron];
} liga_4;


